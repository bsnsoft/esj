<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.bsnsoft.esj</groupId>
  <artifactId>en16931-semantic-json</artifactId>
  <version>0.9.5-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>EN16931 Semantic JSON</name>
  <description>
    A path-based JSON binding of the EN 16931-1 semantic invoice model:
    every value is addressed by a semantic path built from business group and business
    term identifiers, and its semantic data type comes from the term registry.
  </description>
  <!--
    Four attributes, one on the project element above and three on the scm element below,
    keep the url and the scm of a module the url and the scm of this repository: without
    them Maven appends the directory of the module to what it inherits, and every
    published module would name a place that does not exist.
  -->
  <url>https://github.com/bsnsoft/esj</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>BSNSoft Solutions GmbH</name>
  </organization>

  <developers>
    <developer>
      <id>cbuerckert</id>
      <name>Christian Bürckert</name>
      <organization>BSNSoft Solutions GmbH</organization>
      <organizationUrl>https://bsnsoft.de</organizationUrl>
      <roles>
        <role>author</role>
      </roles>
    </developer>
  </developers>

  <modules>
    <module>esj-core</module>
    <module>esj-generator</module>
    <module>esj-typed</module>
    <module>esj-xr</module>
    <module>esj-syntax</module>
    <module>esj-rules</module>
    <module>esj-invoice</module>
    <module>esj-b2c</module>
    <module>esj-bindings</module>
    <module>esj-pdf</module>
    <module>esj-render</module>
    <module>esj-cli</module>
    <module>esj-bom</module>
  </modules>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/bsnsoft/esj.git</connection>
    <developerConnection>scm:git:git@github.com:bsnsoft/esj.git</developerConnection>
    <url>https://github.com/bsnsoft/esj</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!--
      Reproducible builds: every archive entry carries this timestamp instead of the
      moment of the build, so two builds of one commit write the same bytes. It is set
      to the date of the release being prepared (docs/releasing.md).
    -->
    <project.build.outputTimestamp>2026-10-07T08:20:49Z</project.build.outputTimestamp>
    <!--
      A -Dtest pattern that matches no test fails the module it ran in, so that a
      misspelt name is not a green run. With -pl <module> -am the modules built for it
      have none of its tests: -Dsurefire.failIfNoSpecifiedTests=false lets them pass.
    -->
    <surefire.failIfNoSpecifiedTests>true</surefire.failIfNoSpecifiedTests>

    <jackson.version>2.22.3</jackson.version>
    <picocli.version>4.7.7</picocli.version>
    <saxon.version>13.0</saxon.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <zxing.version>3.5.4</zxing.version>
    <junit.version>6.1.3</junit.version>
    <json-schema-validator.version>3.0.8</json-schema-validator.version>
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
    <verapdf.version>1.30.2</verapdf.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <versions-maven-plugin.version>2.22.0</versions-maven-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

    <!--
      The files of EN 16931-1:2026 are separable: model/en16931/2026.paths lists the
      files a distribution leaves out when that edition is not shipped, and the profile
      without-edition-2026 builds such a distribution. These patterns are what that profile changes; by default
      they match nothing, so nothing is left out. An edition is data, so leaving one
      out is a question for the build and never a question for the code.
    -->
    <esj.edition-2026.exclude>en16931/no-edition-is-excluded</esj.edition-2026.exclude>
    <esj.edition-2026.exclude-upgrade>en16931/no-mapping-is-excluded</esj.edition-2026.exclude-upgrade>
    <esj.edition-2026.exclude-schema>no-schema-is-excluded</esj.edition-2026.exclude-schema>
    <esj.edition-2026.exclude-sources>**/no-edition-is-excluded/**</esj.edition-2026.exclude-sources>
    <esj.edition-2026.exclude-rules>no-pack-is-excluded/**</esj.edition-2026.exclude-rules>
    <esj.edition-2026.exclude-conformance>no-measurement-is-excluded/**</esj.edition-2026.exclude-conformance>
    <esj.edition-2026.exclude-service>META-INF/services/no-service-is-excluded</esj.edition-2026.exclude-service>
    <esj.edition-2026.exclude-examples>**/no-example-is-excluded*</esj.edition-2026.exclude-examples>
    <esj.edition-2026.exclude-fixtures>**/no-part-is-excluded*</esj.edition-2026.exclude-fixtures>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <japicmp-maven-plugin.version>0.26.3</japicmp-maven-plugin.version>

    <!--
      The API check of the profile api-check: the release on Maven Central every library
      module is compared with, whether an incompatible change fails the build, and the
      modules that are not compared at all (the two tools set it to true). Until 1.0.0 the
      check reports and does not fail; docs/releasing.md says how to read the report.
    -->
    <!-- Packages the Javadoc leaves out: internal ones; without-edition-2026 adds the edition. -->
    <esj.javadoc.excluded-packages>*.internal:*.internal.*</esj.javadoc.excluded-packages>
    <esj.api-baseline>0.9.4</esj.api-baseline>
    <esj.api-check.break>false</esj.api-check.break>
    <esj.api-check.skip>false</esj.api-check.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>net.sf.saxon</groupId>
        <artifactId>Saxon-HE</artifactId>
        <version>${saxon.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
        <version>${pdfbox.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!--
        The annotation processor of picocli, at build time only. It writes the
        reachability metadata of the command tree — every option, every parameter and
        every converter picocli reaches by reflection — into the jar, so that the native
        executable of dist/package.sh answers as the jar does for an option no case
        happened to exercise. Nothing of it is on the class path at run time.
      -->
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli-codegen</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!--
        The QR encoder of esj-render, used for the one code this project draws: the EPC QR
        code of a credit transfer. Apache-2.0, pure Java, no native part and no transitive
        dependency; only the core artefact, never the javase one, which would bring the
        image classes of the platform into a module that draws vectors.
      -->
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>core</artifactId>
        <version>${zxing.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <!--
        A real PostgreSQL, started from binaries of a Maven artefact, test scope only: every
        SQL statement docs/storage.md prints is executed against it, so the page cannot show
        a statement that does not run. No Docker, no installed server, nothing redistributed,
        and no module depends on it outside its own tests.
      -->
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${embedded-postgres.version}</version>
      </dependency>
      <!--
        The server binaries the artefact above carries by default cover x86-64 on Linux,
        macOS and Windows, at the PostgreSQL release it was built against. The bill of
        materials of those binaries pins every platform's build to one release instead, so
        the page is checked against the same PostgreSQL wherever the build runs; esj-xr adds
        the 64-bit ARM builds from it, for an ARM build server and an Apple Silicon machine.
      -->
      <dependency>
        <groupId>io.zonky.test.postgres</groupId>
        <artifactId>embedded-postgres-binaries-bom</artifactId>
        <version>${embedded-postgres-binaries.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        The PDF/A oracle of esj-render, in test scope and in no published artefact. It is
        dual-licensed GPLv3+ / MPLv2+, which is why it validates the renderings of a build
        and travels with nothing.
      -->
      <dependency>
        <groupId>org.verapdf</groupId>
        <artifactId>validation-model-jakarta</artifactId>
        <version>${verapdf.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <failOnWarning>true</failOnWarning>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <failIfNoSpecifiedTests>${surefire.failIfNoSpecifiedTests}</failIfNoSpecifiedTests>
          </configuration>
        </plugin>
        <!--
          Every jar names the module it is on the module path: esj.automatic-module-name,
          set by each module, is de.bsnsoft.esj followed by the artifact identifier without
          its esj- prefix. Without the entry the module system derives a name from the file
          name, and that name would change with the file. MavenCoordinatesTest holds every
          published jar to its name.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
          <configuration>
            <archive>
              <manifestEntries>
                <Automatic-Module-Name>${esj.automatic-module-name}</Automatic-Module-Name>
              </manifestEntries>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <!--
          The integration tests. A test that spawns the self-contained jar cannot run in
          the test phase, because that jar is written one phase later; declared here so
          that the module that has such tests only has to name the plugin.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>

        <!--
          Every module's jar carries the licence and the notice of the repository under
          META-INF. Apache-2.0 section 4(d) asks a redistributor to pass on the NOTICE of
          a work that has one, and a reader who takes the artefact out of a repository
          never sees this tree; the producer is the one who can make that easy. The two
          files sit at the root of the repository, one directory above every module.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
          <executions>
            <execution>
              <id>attribution</id>
              <phase>process-classes</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                <resources>
                  <resource>
                    <directory>${project.basedir}/..</directory>
                    <includes>
                      <include>LICENSE</include>
                      <include>NOTICE</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <!--
          No build uses it; it is named here so that the one command that sets the version
          of every module, in docs/releasing.md, runs a version this project chose rather
          than whichever one is newest on the day of a release.
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
          <configuration>
            <failOnError>true</failOnError>
            <failOnWarnings>true</failOnWarnings>
            <doclint>all</doclint>
            <notimestamp>true</notimestamp>
            <!--
              The API is what the Javadoc shows. A package whose name contains internal is
              public because a module of this project needs it, not because a caller has
              business with it, and its documentation is the source.
            -->
            <excludePackageNames>${esj.javadoc.excluded-packages}</excludePackageNames>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>package</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        What a release adds to the everyday build: a signature beside every file, and the
        upload of the reactor to the Central Portal as one deployment. The source and the
        Javadoc jar are not in here. Every build writes them, because the Javadoc run is
        one of this project's gates — it fails on a warning — and a gate a release is the
        first to run is no gate.
      -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <configuration>
              <!--
                The passphrase is read from the environment variable MAVEN_GPG_PASSPHRASE
                and from nowhere else: bestPractices refuses one that stands in a file or on
                the command line. The signer calls gpg in batch mode, without a terminal and
                with the loopback pinentry, so an unattended build needs no further argument;
                the key it signs with is the one secret key of the keyring the build imported.
              -->
              <bestPractices>true</bestPractices>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <!--
              An extension, because it takes the deploy phase away from maven-deploy-plugin:
              the whole reactor travels as one bundle to the Portal, which validates it and
              publishes it or rejects it as a whole.
            -->
            <extensions>true</extensions>
            <configuration>
              <!-- The credentials are the Portal user token, under this id in settings.xml. -->
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>validated</waitUntil>
              <!-- What the deployment is called on the Portal. Not the artifact id of a
                   module: the goal runs once for the whole reactor, in the module that
                   happens to be last. -->
              <deploymentName>EN16931 Semantic JSON ${project.version}</deploymentName>
              <!--
                esj-cli is the command line tool, and it ships as the archives of a GitHub
                release rather than as a library (docs/install.md). esj-generator is the
                build tool that writes the checked-in sources of this repository and makes
                no promise to anyone else. Both are built here like every other module and
                are the two modules the deployment leaves out.
              -->
              <excludeArtifacts>
                <excludeArtifact>esj-cli</excludeArtifact>
                <excludeArtifact>esj-generator</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Compares the public API of every library module with the release named by
        esj.api-baseline, using japicmp on the jars: mvn -B -Papi-check verify. The report
        is target/japicmp/api-check.html (and .md) in each module. What is not API is left
        out: packages whose name contains internal, the preview packages of the 2026
        edition and of the upgrade, the B2C overlay, and every element marked with
        de.bsnsoft.esj.Preview. Until 1.0.0 the check only reports (esj.api-check.break).
      -->
      <id>api-check</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.siom79.japicmp</groupId>
            <artifactId>japicmp-maven-plugin</artifactId>
            <version>${japicmp-maven-plugin.version}</version>
            <configuration>
              <skip>${esj.api-check.skip}</skip>
              <oldVersion>
                <dependency>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <version>${esj.api-baseline}</version>
                  <type>jar</type>
                </dependency>
              </oldVersion>
              <newVersion>
                <file>
                  <path>${project.build.directory}/${project.build.finalName}.jar</path>
                </file>
              </newVersion>
              <parameter>
                <onlyModified>true</onlyModified>
                <skipPomModules>true</skipPomModules>
                <breakBuildOnBinaryIncompatibleModifications>${esj.api-check.break}</breakBuildOnBinaryIncompatibleModifications>
                <breakBuildOnSourceIncompatibleModifications>${esj.api-check.break}</breakBuildOnSourceIncompatibleModifications>
                <excludes>
                  <exclude>*.internal.*</exclude>
                  <exclude>*.v2026.*</exclude>
                  <exclude>de.bsnsoft.esj.upgrade.*</exclude>
                  <exclude>de.bsnsoft.esj.b2c.*</exclude>
                  <exclude>@de.bsnsoft.esj.Preview</exclude>
                </excludes>
              </parameter>
            </configuration>
            <executions>
              <execution>
                <id>api-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>cmp</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Builds ESJ without the files of EN 16931-1:2026. Whether a registry of that
        edition may be published is a question that is open at the time of writing, and
        the answer must not decide whether the rest of the project builds: under this
        profile the paths of model/en16931/2026.paths reach no artefact, the loader
        reports the editions it actually carries, and everything that needs the edition
        stands down instead of failing.
      -->
      <id>without-edition-2026</id>
      <properties>
        <esj.edition-2026.exclude>en16931/2026*</esj.edition-2026.exclude>
        <esj.edition-2026.exclude-upgrade>en16931/upgrade-*</esj.edition-2026.exclude-upgrade>
        <esj.edition-2026.exclude-schema>esj-en16931-2026.schema.json</esj.edition-2026.exclude-schema>
        <esj.edition-2026.exclude-sources>**/v2026/**</esj.edition-2026.exclude-sources>
        <esj.javadoc.excluded-packages>*.internal:*.internal.*:*.v2026:*.v2026.*</esj.javadoc.excluded-packages>
        <esj.edition-2026.exclude-rules>en16931-2026/**</esj.edition-2026.exclude-rules>
        <esj.edition-2026.exclude-conformance>rules-2026/**</esj.edition-2026.exclude-conformance>
        <esj.edition-2026.exclude-service>META-INF/services/de.bsnsoft.esj.rules.RulePackSource</esj.edition-2026.exclude-service>
        <esj.edition-2026.exclude-examples>**/edition-2026*</esj.edition-2026.exclude-examples>
        <esj.edition-2026.exclude-fixtures>fixtures/*en16931-2026*</esj.edition-2026.exclude-fixtures>
      </properties>
    </profile>
  </profiles>
</project>
