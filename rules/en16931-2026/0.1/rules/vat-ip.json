  {
    "id": "BR-IP-09",
    "severity": "fatal",
    "oracle": "cases",
    "context": "/BG-23/*",
    "terms": [
      "BT-116",
      "BT-117",
      "BT-118",
      "BT-119",
      "BT-184"
    ],
    "assert": {
      "if": {
        "condition": {
          "and": [
            {
              "eq": [
                {
                  "value": "/BT-118"
                },
                {
                  "const": "M"
                }
              ]
            },
            {
              "exists": "/BT-117"
            },
            {
              "exists": "/BT-119"
            },
            {
              "or": [
                {
                  "absent": "/BT-184"
                },
                {
                  "eq": [
                    {
                      "value": "/BT-184"
                    },
                    {
                      "atRoot": {
                        "value": "/BT-5"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "then": {
          "le": [
            {
              "abs": {
                "sub": [
                  {
                    "value": "/BT-117"
                  },
                  {
                    "round": [
                      {
                        "div": [
                          {
                            "mul": [
                              {
                                "value": "/BT-116"
                              },
                              {
                                "value": "/BT-119"
                              }
                            ]
                          },
                          {
                            "const": 100
                          }
                        ]
                      },
                      {
                        "atRoot": {
                          "minorUnit": [
                            {
                              "value": "/BT-5"
                            },
                            "iso-4217"
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "min": [
                {
                  "max": [
                    {
                      "mul": [
                        {
                          "const": "0.001"
                        },
                        {
                          "abs": {
                            "value": "/BT-117"
                          }
                        }
                      ]
                    },
                    {
                      "const": "0.01"
                    }
                  ]
                },
                {
                  "const": 1
                }
              ]
            }
          ]
        }
      }
    },
    "bind": {
      "tax": {
        "round": [
          {
            "div": [
              {
                "mul": [
                  {
                    "value": "/BT-116"
                  },
                  {
                    "value": "/BT-119"
                  }
                ]
              },
              {
                "const": 100
              }
            ]
          },
          {
            "atRoot": {
              "minorUnit": [
                {
                  "value": "/BT-5"
                },
                "iso-4217"
              ]
            }
          }
        ]
      }
    },
    "message": "The VAT breakdown at {.} is categorised \"M\" (Ceuta and Melilla tax) with the taxable amount (BT-116) {/BT-116} at the rate (BT-119) {/BT-119} per cent, which comes to {$tax}, and states the tax amount (BT-117) {/BT-117}.",
    "source": "EN 16931-1:2026, 6.4.3.4.15, Table 15, BR-IP-9",
    "note": "The 2017 edition stated this arithmetic in one rule for every category (BR-CO-17) and rounded to two fraction digits; this edition withdraws that rule, states the arithmetic per category, rounds to the minor unit of the invoice currency (BT-5) and admits the tolerance of clause 6.5.14: a thousandth of the stated tax amount, never below 0,01 and never above 1. The comparison keeps the sign: a tax amount of the opposite sign to the taxable amount fails it, where the artefacts of the 2017 edition compared the two without their signs. A breakdown in the VAT accounting currency (BT-184 other than BT-5) is left to BR-CO-50."
  }
