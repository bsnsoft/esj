  "$defs": {
    "textValue": {
      "$comment": "Registry datatype Text: any non-empty string, line breaks included (SPEC.md section 6.8). The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string"
    },
    "identifierValue": {
      "$comment": "Registry datatype Identifier: any non-empty string (SPEC.md section 6.6). The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string"
    },
    "identifierValueWithOptionalScheme": {
      "$comment": "Registry datatype Identifier: any non-empty string (SPEC.md section 6.6). Every supplementary component of this shape is optional, so the value is a string where it carries none and an object where it carries one (SPEC.md section 6.1).",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["value", "scheme"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "string" },
            "scheme": { "type": "string" }
          }
        }
      ]
    },
    "identifierValueWithScheme": {
      "$comment": "Registry datatype Identifier: any non-empty string (SPEC.md section 6.6). The registry declares scheme mandatory for the terms of this shape, so such a value is always written as an object.",
      "type": "object",
      "required": ["value", "scheme"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "scheme": { "type": "string" }
      }
    },
    "identifierValueWithSchemeOptionalSchemeVersion": {
      "$comment": "Registry datatype Identifier: any non-empty string (SPEC.md section 6.6). The registry declares scheme mandatory for the terms of this shape, so such a value is always written as an object, and it may carry schemeVersion beside the mandatory ones.",
      "type": "object",
      "required": ["value", "scheme"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "scheme": { "type": "string" },
        "schemeVersion": { "type": "string" }
      }
    },
    "codeValue": {
      "$comment": "Registry datatype Code: the code as the list the semantic model fixes for the term spells it; membership in that list is a business rule and is not checked here (SPEC.md sections 6.3 and 9.4). The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string"
    },
    "dateValue": {
      "$comment": "Registry datatype Date: the date grammar of SPEC.md section 6.5. Whether the day exists in the calendar is beyond a pattern and stays a check of validation layer L2. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "pattern": "^[1-9][0-9]{3}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
    },
    "timeValue": {
      "$comment": "Registry datatype Time: the time grammar of SPEC.md section 6.5, which carries the offset from UTC and admits one spelling per value. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "pattern": "^(?![0-9:]+[+-]00:00(?![\\s\\S]))(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])"
    },
    "amountValue": {
      "$comment": "Registry datatype Amount: the canonical decimal form of SPEC.md section 6.4, bounded at 64 characters. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!-0(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "unitPriceAmountValue": {
      "$comment": "Registry datatype UnitPriceAmount: the canonical decimal form of SPEC.md section 6.4, bounded at 64 characters. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!-0(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "quantityValue": {
      "$comment": "Registry datatype Quantity: the canonical decimal form of SPEC.md section 6.4, bounded at 64 characters. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!-0(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "percentageValue": {
      "$comment": "Registry datatype Percentage: the canonical decimal form of SPEC.md section 6.4, bounded at 64 characters. The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!-0(?![\\s\\S]))-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "documentReferenceValue": {
      "$comment": "Registry datatype DocumentReference: any non-empty string; the type is derived from Identifier and EN 16931-1 gives it content alone (SPEC.md section 6.3). The registry lists no supplementary component for the terms of this shape, so such a value is always written as a string.",
      "type": "string"
    },
    "binaryObjectValueWithMimeCodeFilename": {
      "$comment": "Registry datatype BinaryObject: the canonical padded base64 of SPEC.md section 6.7. The registry declares mimeCode and filename mandatory for the terms of this shape, so such a value is always written as an object.",
      "type": "object",
      "required": ["value", "mimeCode", "filename"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{4}|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)(?![\\s\\S])" },
        "mimeCode": { "type": "string" },
        "filename": { "type": "string" }
      }
    }
  }
}
