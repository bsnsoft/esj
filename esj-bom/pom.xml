<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.bsnsoft.esj</groupId>
    <artifactId>en16931-semantic-json</artifactId>
    <version>0.9.5-SNAPSHOT</version>
  </parent>

  <artifactId>esj-bom</artifactId>
  <packaging>pom</packaging>

  <name>EN16931 Semantic JSON :: Bill of materials</name>
  <description>
    The versions of every published module of this project, to be imported once so that a
    build names an artifact without naming a version. The two tools are not among them:
    the command line tool ships as the archives of a release, and the generator is a build
    tool of this repository.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-typed</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-xr</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-syntax</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-rules</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-invoice</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-b2c</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-bindings</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-pdf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.bsnsoft.esj</groupId>
        <artifactId>esj-render</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        The POM a build of someone else imports is the flattened one: no parent, and in
        dependencyManagement only the modules above. Imported with its parent, it would
        hand on every version the aggregator manages for this project's own build —
        JUnit, Saxon, PDFBox, Jackson and the rest — and decide them for the importer.
        The flattened POM keeps the metadata Maven Central asks for, resolved from the
        parent; the release profile signs and deploys it in place of this file.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>bom</flattenMode>
          <updatePomFile>true</updatePomFile>
          <outputDirectory>${project.build.directory}</outputDirectory>
          <flattenedPomFilename>esj-bom.pom</flattenedPomFilename>
          <pomElements>
            <properties>remove</properties>
            <dependencyManagement>keep</dependencyManagement>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
