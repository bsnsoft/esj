# The Linux native executable, built with GraalVM in a container so that a
# machine of any kind can produce it:
#
#   docker build --platform linux/arm64 -f dist/Dockerfile.native \
#       --target artefact --output type=local,dest=dist/out/linux-arm64 .
#
# The build stage runs dist/native-image.sh, the same script that builds the
# executable of the host, so the two are built from the same cases and the same
# resource discovery. The last stage is the executable and the shared libraries
# it loads, nothing else, so that the output of the build is the artefact.
#
# Copyright 2026 BSNSoft Solutions GmbH. Author: Christian Bürckert. Licensed under the Apache License, Version 2.0.

# Both base images are pinned by the digest of their manifest list beside the
# tag, which Dependabot moves with the tag (.github/dependabot.yml).
FROM ghcr.io/graalvm/native-image-community:25@sha256:0d936f32bb8acb5bc60c41b33e05f064d7a6aaf36b726538296c54949bd4a3c0 AS build
WORKDIR /src
COPY . /src
RUN dist/native-image.sh esj-cli/target/esj.jar /out \
    && mkdir /artefact \
    && cp /out/esj /src/LICENSE /src/NOTICE /artefact/ \
    && cp -R /out/legal /artefact/legal \
    && cp /out/*.so* /artefact/ 2>/dev/null || true

FROM scratch AS artefact
COPY --from=build /artefact /

# The same executable in an image that can run it: a base with the C library it
# is linked against and nothing else to speak of. The runtime libraries the
# executable loads from beside itself when it renders travel with it.
FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5 AS image
COPY --from=build /artefact/ /opt/esj/
WORKDIR /work
USER nonroot
# esj serve listens on every interface of the container (docs/serve.md), and gives
# every child the heap of ESJ_MAX_HEAP. There is no shell to choose the heap of the
# server process itself: it keeps the ceiling built into the executable (512 MiB), of
# which it uses little, unless the command line names another before the command:
#   docker run ... <image> -Xmx128m serve
ENV ESJ_MAX_HEAP=512m \
    ESJ_SERVE_BIND=0.0.0.0
EXPOSE 8080
ENTRYPOINT ["/opt/esj/esj"]
CMD ["--help"]
